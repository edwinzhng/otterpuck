FROM oven/bun:1.4.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ARG PUBLIC_ROOMS_HOME_URL
ARG PUBLIC_ROOMS_US_URL
ARG PUBLIC_ROOMS_EU_URL
RUN bun run build

FROM oven/bun:1.4.2
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY index.html server.ts ./
COPY src ./src
COPY --from=build /app/dist ./dist
USER bun
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3200
EXPOSE 3200
CMD ["bun", "run", "server.ts", "--production"]
