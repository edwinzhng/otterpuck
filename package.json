{
  "name": "otterpuck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun run build.ts",
    "start": "bun run server.ts --production",
    "start:lan": "HOST=0.0.0.0 PORT=3204 bun run server.ts --production",
    "check": "bun x biome check . && bun x tsc --noEmit && bun run check:conventions",
    "check:conventions": "bun run scripts/check-conventions.ts",
    "test": "bun test",
    "benchmark": "bun run scripts/benchmark.ts",
    "assets:characters": "bun art/characters/export.ts",
    "assets:arenas": "bun art/arenas/export.ts",
    "rooms": "bun run services/server.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "@types/three": "0.185.4",
    "railway": "^3.11.0",
    "typescript": "7.0.2"
  },
  "description": "A stylized underwater hockey game built with Three.js and Blender."
}
