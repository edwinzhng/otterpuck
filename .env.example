# Browser-visible region endpoints; set after Railway assigns service domains.
PUBLIC_ROOMS_US_URL=wss://YOUR-US-SERVICE.up.railway.app/socket
PUBLIC_ROOMS_EU_URL=wss://YOUR-EU-SERVICE.up.railway.app/socket
# Room server only. Comma-separated exact frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
ROOM_REGION=local
# Cloud service origins and regions are declared in .railway/railway.ts.

# Self-hosting with docker-compose (copy to .env beside docker-compose.yml).
# LAN-only over plain HTTP: use your Pi's address or <hostname>.local, and use
# the SAME spelling in both values or the room server's origin check rejects it.
# PUBLIC_ROOMS_HOME_URL=ws://192.168.1.50:3210/socket
# ALLOWED_ORIGINS=http://192.168.1.50:3200
# Behind a TLS reverse proxy instead, and TRUST_PROXY so per-IP limits see
# the real client address rather than the proxy's.
# PUBLIC_ROOMS_HOME_URL=wss://otterpuck.example.com/socket
# ALLOWED_ORIGINS=https://otterpuck.example.com
# TRUST_PROXY=1
