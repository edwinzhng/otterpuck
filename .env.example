# Browser-visible region endpoints; set after Railway assigns service domains.
PUBLIC_ROOMS_US_URL=wss://YOUR-US-SERVICE.up.railway.app/socket
PUBLIC_ROOMS_EU_URL=wss://YOUR-EU-SERVICE.up.railway.app/socket
# Room server only. Comma-separated exact frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
ROOM_REGION=local
# Cloud service origins and regions are declared in .railway/railway.ts.
